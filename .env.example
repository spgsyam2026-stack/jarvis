# GEMINI_API_KEY: Primary AI engine for AETHER // OS (Search grounding, multimodal vision, speech transcription).
# Free tier available via Google AI Studio (https://aistudio.google.com/app/apikey).
# In Google AI Studio Build, this is automatically injected from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Free & Low-Cost Alternative AI Model Providers:

# DEEPSEEK_API_KEY: DeepSeek V3 (deepseek-chat) and DeepSeek R1 reasoning (deepseek-reasoner).
# Ultra-low cost API with generous free trial credits (https://platform.deepseek.com).
DEEPSEEK_API_KEY=

# MOONSHOT_API_KEY: Kimi / Moonshot AI (moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k, kimi-latest).
# Long-context Chinese & English reasoning models (https://platform.moonshot.cn).
MOONSHOT_API_KEY=

# OPENROUTER_API_KEY: Access 100+ AI models including 100% FREE models:
# deepseek/deepseek-r1:free, deepseek/deepseek-chat:free, meta-llama/llama-3.3-70b-instruct:free
# (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# GROQ_API_KEY: Ultra-fast LPU inference with generous free tier:
# deepseek-r1-distill-llama-70b, llama-3.3-70b-versatile, mixtral-8x7b-32768
# (https://console.groq.com/keys)
GROQ_API_KEY=

# Standard OpenAI & Anthropic fallback keys:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

